PORT=4173
DATABASE_PATH=./data/wenying.sqlite
# Append-only JSONL trace for every created media asset
GENERATION_METADATA_LOG_PATH=./data/generation-metadata.jsonl
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
REWRITE_TIMEOUT_MS=45000
STRUCTURED_TIMEOUT_MS=90000
STRUCTURED_RETRIES=3
SOURCE_RETENTION_HOURS=24

# Real Doubao TTS provider
TTS_PROVIDER=doubao
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE=

# Remote ComfyUI video generation. Set MEDIA_PROVIDER=comfyui after placing
# the workflow exported with "Save (API Format)" in the local workflows/ dir.
MEDIA_OUTPUT_DIR=./data/media
COMFYUI_BASE_URL=https://your-comfyui.example.com
COMFYUI_WORKFLOW_PATH=./workflows/video_wan2_2_5b_i2v_api.json
COMFYUI_WORKFLOW_MANIFEST_PATH=./workflows/manifests/wan22-5b-i2v.json
COMFYUI_IMAGE_WORKFLOW_PATH=./workflows/z-image-turbo-t2i-api.json
COMFYUI_IMAGE_WORKFLOW_MANIFEST_PATH=./workflows/manifests/krea2-turbo-t2i.json
COMFYUI_KEYFRAME_WORKFLOW_PATH=./workflows/krea2-keyframe-img2img-api.json
COMFYUI_KEYFRAME_WORKFLOW_MANIFEST_PATH=./workflows/manifests/krea2-keyframe-img2img.json
COMFYUI_KEYFRAME_DENOISE=0.82
COMFYUI_KEYFRAME_USE_REFERENCE=true
COMFYUI_IMAGE_NEGATIVE_PROMPT=分格，多格漫画，拼贴，上下分屏，左右分屏，重复人物，排版，可读数字，可读文字，中文文字，字幕，水印，边框
COMFYUI_IMAGE_WIDTH=576
COMFYUI_IMAGE_HEIGHT=1024
KEYFRAME_REQUIRED=true
# auto：只要配置了关键帧 img2img 工作流，就强制关键帧必须消费参考图；
# true / false 可显式开启或关闭该校验。
KEYFRAME_REFERENCE_REQUIRED=auto
COMFYUI_API_KEY=
COMFYUI_AUTH_TOKEN=
COMFYUI_BASIC_AUTH=
COMFYUI_INPUT_IMAGE_PATH=
COMFYUI_TIMEOUT_MS=900000
COMFYUI_POLL_MS=1000
COMFYUI_WIDTH=576
COMFYUI_HEIGHT=1024
COMFYUI_FRAMES=121
COMFYUI_FPS=24
COMFYUI_FIXED_SEED=
COMFYUI_NEGATIVE_PROMPT=blurry, low quality, flicker, watermark, text, distorted anatomy, duplicate limbs
FFPROBE_PATH=ffprobe
LLM_STRUCTURED_TEMPERATURE=0.2

# AI prompts. Use \\n for line breaks; restart the server after changing them.
LLM_REWRITE_SYSTEM_PROMPT=你是一名中文短视频小说解说编剧。请把用户提供的小说正文改写成适合口播的视频解说稿。\n要求：\n1. 压缩重复描写，保留关键剧情、人物关系和因果，不虚构原文没有的事实。\n2. 第一段要有明确悬念钩子，结尾要留下悬念或推动下一段。\n3. 使用自然、连贯、适合普通话口播的中文，不写舞台指令，不使用 Markdown。\n4. 按场景或语义自然分段，不设固定的最少或最多段数；正文很短时只返回 1 段，不要为了凑数量拆分。每段长度以内容完整、适合口播为准。\n5. 只输出合法 JSON，格式必须是：{"cleanedText":"...","segments":[{"sequence":1,"title":"...","scriptText":"...","summary":"..."}]}。\n6. sequence 从 1 连续递增；每段 scriptText 不得为空；title 不超过 20 个字符；summary 可为空。\n不要输出 JSON 之外的任何解释。
LLM_REWRITE_USER_PROMPT_TEMPLATE=题材：{genre}\n任务幂等键：{idempotencyKey}\n\n小说正文：\n{sourceText}
LLM_SHOT_SYSTEM_PROMPT=你是影视分镜设计师。根据一段中文口播和视觉设定，生成连续、细腻、适合文生视频模型理解的中文单镜头描述。\n每个镜头只包含一个连续动作、一个主要主体和一个镜头运动，不写对白字幕，不写蒙太奇或镜头切换。镜头数量必须严格等于用户给出的数量，数量为 1 时只返回 1 个镜头。必须严格输出 JSON：{"shots":[{"sequence":1,"promptZh":"..."}]}。promptZh 使用中文，包含主体外观、场景、动作、构图、光线、氛围和镜头运动。
LLM_SHOT_USER_PROMPT_TEMPLATE=题材：{genre}\n镜头数量：{count}\n视觉设定：{visualBible}\n片段摘要：{summary}\n口播：{scriptText}\n任务：{idempotencyKey}
LLM_VISUAL_BIBLE_SYSTEM_PROMPT=你是影视美术指导。根据小说口播片段提取统一的视觉设定，只输出 JSON：{"characters":[{"name":"","appearance":"","costume":""}],"scenes":[{"name":"","description":""}],"style":""}。不得虚构剧情。
LLM_VISUAL_BIBLE_USER_PROMPT_TEMPLATE=题材：{genre}\n画面风格：{visualStyle}\n口播片段：{segments}\n任务：{idempotencyKey}

LLM_DIRECTOR_SYSTEM_PROMPT=你是影视导演分析师。只分析剧情，不选择景别、角度、运镜、构图或焦段。把每个片段拆成与 targetShotCount 相同数量的连续剧情节拍。每个节拍必须把心理或抽象叙事转成可拍摄的 visibleAction，并区分必须出现、禁止出现、仅由声音表达和需要后期完成的内容。严格输出 JSON：{"segments":[{"segmentId":"","beats":[{"beatId":"","plot":"","emotion":"","emotionIntensity":0.5,"action":"","visibleAction":"","startState":"","endState":"","actionSpeed":"慢/中/快","sceneType":"","narrativePurpose":"","subjectCount":1,"mustShow":[],"mustNotShow":[],"audioOnlyEvents":[],"postproductionElements":[],"continuityConstraints":[]}]}]}。segmentId 必须原样返回；plot 不得虚构原文事实；声音事件不得自动具象化；精确屏幕文字应放入 postproductionElements；emotionIntensity 范围 0 到 1。
LLM_DIRECTOR_USER_PROMPT_TEMPLATE=题材：{genre}\n全片配置：{configuration}\n片段：{segments}\n任务：{idempotencyKey}
LLM_CAMERA_SYSTEM_PROMPT=你是摄影指导。根据导演分析、视觉设定和 RAG 知识证据为每个剧情节拍选择一个可执行的镜头。不得改写剧情和叙事目的；每个 selection 必须引用提供的 evidence id，不得虚构 id；每个 selection 的 evidenceIds 只能从该 selection 自己的 beatId 对应的 evidence 列表里挑，禁止引用其它节拍的 id；单镜头只使用一种主要运镜。严格输出 JSON：{"segments":[{"segmentId":"","selections":[{"beatId":"","shotSize":"中景","angle":"平视","movement":"固定镜头","focalLengthMm":50,"composition":"三分法","durationMs":5000,"selectionReason":"","evidenceIds":[""],"transitionToNext":{"type":"cut/match_cut/dissolve/fade","durationMs":0,"motivation":"","execution":"composer","evidenceIds":[]}}]}]}。焦段 12 到 200，时长 1800 到 6000 毫秒。
# RAG_EVIDENCE_STRICT=true 时，模型引用了不属于该节拍的知识 id 会直接失败（默认修复并继续）
LLM_CAMERA_USER_PROMPT_TEMPLATE=导演分析：{directorAnalysis}\nRAG 检索证据：{retrievalContexts}\n视觉设定：{visualBible}\n全片配置：{configuration}\n任务：{idempotencyKey}
LLM_STORYBOARD_SYSTEM_PROMPT=你是分镜师。把导演分析和摄影选择合并为最终分镜表，不重新作导演或摄影决策，不新增剧情。严格输出 JSON：{"segments":[{"segmentId":"","shots":[{"sequence":1,"beatId":"","plot":"","shotSize":"","movement":"","angle":"","focalLengthMm":50,"composition":"","purpose":"","durationMs":5000,"selectionReason":"","evidenceIds":[],"transitionToNext":null}]}]}。每个剧情节拍必须至少对应一个镜头，sequence 从 1 连续递增。
LLM_STORYBOARD_USER_PROMPT_TEMPLATE=导演分析：{directorAnalysis}\n镜头选择：{shotSelection}\n视觉设定：{visualBible}\n全片配置：{configuration}\n任务：{idempotencyKey}

VIDEO_DEFAULT_PROMPT_TEMPLATE={genre}小说场景，{summaryOrTitle}，人物动作与解说内容一致，电影级构图
VIDEO_FALLBACK_SHOT_PROMPT_TEMPLATE={title}，连续动作，电影级构图
VIDEO_FINAL_FALLBACK_PROMPT_TEMPLATE={genre}小说场景，{scriptText}，人物动作与解说内容一致，电影级构图
MEDIA_PROVIDER=comfyui
COMPOSER_PROVIDER=ffmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_FONT_PATH=
