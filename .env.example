PORT=4173
DATABASE_PATH=./data/wenying.sqlite
# Append-only JSONL trace for every created media asset
GENERATION_METADATA_LOG_PATH=./data/generation-metadata.jsonl
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
REWRITE_TIMEOUT_MS=45000
STRUCTURED_TIMEOUT_MS=90000
STRUCTURED_RETRIES=3
SOURCE_RETENTION_HOURS=24

# Real Doubao TTS provider
TTS_PROVIDER=doubao
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE=

# Remote ComfyUI video generation. Set MEDIA_PROVIDER=comfyui after placing
# the workflow exported with "Save (API Format)" in the local workflows/ dir.
MEDIA_OUTPUT_DIR=./data/media
COMFYUI_BASE_URL=https://your-comfyui.example.com
COMFYUI_WORKFLOW_PATH=./workflows/video_wan2_2_5b_i2v_api.json
COMFYUI_WORKFLOW_MANIFEST_PATH=./workflows/manifests/wan22-5b-i2v.json
COMFYUI_IMAGE_WORKFLOW_PATH=./workflows/z-image-turbo-t2i-api.json
COMFYUI_IMAGE_WORKFLOW_MANIFEST_PATH=./workflows/manifests/z-image-turbo-t2i.json
COMFYUI_KEYFRAME_WORKFLOW_PATH=./workflows/krea2-keyframe-img2img-api.json
COMFYUI_KEYFRAME_WORKFLOW_MANIFEST_PATH=./workflows/manifests/krea2-keyframe-img2img.json
COMFYUI_KEYFRAME_DENOISE=0.82
COMFYUI_KEYFRAME_USE_REFERENCE=true
COMFYUI_SCENE_PLATE_WORKFLOW_PATH=./workflows/qwen-image-scene-plate-api.json
COMFYUI_SCENE_PLATE_WORKFLOW_MANIFEST_PATH=./workflows/manifests/qwen-image-scene-plate.json
SCENE_PLATE_REQUIRED=auto
# 角色/场景/道具参考图与已选关键帧的提示词调整也复用这组图生图配置。
COMFYUI_IMAGE_WIDTH=576
COMFYUI_IMAGE_HEIGHT=1024
KEYFRAME_REQUIRED=true
# auto：只要配置了关键帧 img2img 工作流，就强制关键帧必须消费参考图；
# true / false 可显式开启或关闭该校验。
KEYFRAME_REFERENCE_REQUIRED=auto
COMFYUI_API_KEY=
COMFYUI_AUTH_TOKEN=
COMFYUI_BASIC_AUTH=
COMFYUI_INPUT_IMAGE_PATH=
COMFYUI_TIMEOUT_MS=900000
COMFYUI_POLL_MS=1000
COMFYUI_WIDTH=576
COMFYUI_HEIGHT=1024
COMFYUI_FRAMES=121
COMFYUI_FPS=24
COMFYUI_FIXED_SEED=
FFPROBE_PATH=ffprobe
LLM_STRUCTURED_TEMPERATURE=0.2

# 所有提示词按功能拆分在 ./prompts 下；可用 PROMPTS_DIR 替换提示词目录。
# RAG_EVIDENCE_STRICT=true 时，模型引用了不属于该节拍的知识 id 会直接失败（默认修复并继续）。



MEDIA_PROVIDER=comfyui
COMPOSER_PROVIDER=ffmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_FONT_PATH=

# --- 关键帧：多图参考（Qwen-Image-Edit-2511 GGUF）---
# 现在的关键帧用单图 img2img（Krea2），模型只能拿到一张参考图，
# 所以“角色图 + 场景图”会被它硬凑成上下拼贴，景别也不听分镜。
# 前置：远程 ComfyUI 装好自定义节点 ComfyUI-GGUF，并放好
#   models/diffusion_models/qwen-image-edit-2511-Q4_K_M.gguf
#   models/text_encoders/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
# 然后跑 npm run check:keyframe-edit 确认全部 ✓，
# 再把上面 COMFYUI_KEYFRAME_* 三行换成下面这三行并重启服务：
# COMFYUI_KEYFRAME_WORKFLOW_PATH=./workflows/qwen-image-edit-keyframe-api.json
# COMFYUI_KEYFRAME_WORKFLOW_MANIFEST_PATH=./workflows/manifests/qwen-image-edit-keyframe.json
# COMFYUI_KEYFRAME_DENOISE=1
